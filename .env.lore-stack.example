# Server IP address or DNS name used by Lore clients. Change this value for LAN deployments.
LORE_EXTERNAL_HOST=192.168.1.2

# auto: create a local CA and server certificate; custom: use certificates from LORE_TLS_SOURCE_DIR.
LORE_TLS_MODE=auto
LORE_TLS_VALID_DAYS=825
LORE_TLS_SOURCE_DIR=./deploy/lore-stack/certs
LORE_TLS_CERT_FILE=fullchain.pem
LORE_TLS_KEY_FILE=privkey.pem
LORE_TLS_CA_FILE=ca.pem

# Optional Lore Server override directory. Place a user-maintained local.toml here.
LORE_SERVER_CONFIG_DIR=./deploy/lore-stack/config

# Published ports. Container ports remain fixed, and generated integration settings use these Auth ports.
LORE_SERVER_PORT=41337
LORE_SERVER_HTTP_PORT=41339
LORE_AUTH_HTTPS_PORT=8080
LORE_AUTH_GRPC_PORT=50051

# The manual GitHub Actions workflow builds Lore Server from the official upstream source.
LORE_SERVER_PLATFORM=linux/amd64
LORE_STACK_INIT_IMAGE=ghcr.io/arnochenfx/lore-stack-init:latest
LORE_SERVER_IMAGE=ghcr.io/arnochenfx/lore-server:stable
LORE_AUTH_IMAGE=ghcr.io/arnochenfx/lore-auth-service:latest

# This administrator is created on first startup. Replace the placeholder password before starting
# the stack; the service refuses publicly documented placeholder values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
LORE_ENVIRONMENT=production

# Token and browser authentication session lifetimes, in seconds.
# Access tokens default to 10 days so Lore clients do not need to sign in daily. For sensitive
# deployments use a shorter TOKEN_TTL, such as 28800; see the README section "Token lifetime".
TOKEN_TTL=864000
REFRESH_TOKEN_TTL=604800
AUTH_SESSION_TTL=300

# Password login throttling; a value of 0 disables that scope. See the README section "Login throttling".
LOGIN_MAX_FAILURES_PER_USER_IP=5
LOGIN_MAX_FAILURES_PER_IP=100
LOGIN_MAX_FAILING_IPS_PER_ACCOUNT=50
LOGIN_LOCK_BASE_SECONDS=60
LOGIN_LOCK_MAX_SECONDS=900
# Sources with a successful login for the account within this many seconds are exempt from the
# account-wide lock; 0 disables the exemption.
LOGIN_RECENT_SUCCESS_SECONDS=2592000

# Keep 0 unless a reverse proxy in front of lore-auth forwards client addresses in X-Forwarded-For.
TRUSTED_PROXY_COUNT=0
