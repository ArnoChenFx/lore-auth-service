# ── Lore Auth Service Environment Variables ──

# HTTP listening port
PORT=8080

# JWT issuer; must match the jwt_issuer in Lore Server configuration.
# If Lore Server is deployed remotely, use an externally reachable address here.
JWT_ISSUER=http://localhost:8080

# JWT audience; must match one of the entries in the jwt_audience list
# in Lore Server configuration.
JWT_AUDIENCE=lore-service

# Token time-to-live, in seconds.
TOKEN_TTL=3600

# RSA key storage directory.
KEY_DIR=./keys

# Database path.
DB_PATH=./lore-auth.db

# Administrator account created on first startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
