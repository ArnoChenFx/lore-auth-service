# ── Lore Auth Service Environment Variables ──

# HTTP/HTTPS browser and management endpoint.
HOST=0.0.0.0
PORT=8080

# Lore native gRPC Auth/ReBAC endpoint.
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# Browser-visible origin used to build the login URL returned to Lore Client.
PUBLIC_BASE_URL=http://localhost:8080

# JWT issuer; must exactly match server.auth.jwt_issuer in Lore Server.
JWT_ISSUER=http://localhost:8080

# Comma-separated DNS hostnames that may receive the JWT. For production this must
# contain the hostname from the Lore repository URL, not an abstract service name.
JWT_AUDIENCE=localhost

# Value written into Lore's required env claim.
LORE_ENVIRONMENT=production

# Access token time-to-live, in seconds. The default is 10 days. Lore Server accepts a token until it
# expires, even after its user is deleted. Sensitive deployments should use a shorter value, for
# example 28800; see the README section "Token lifetime".
TOKEN_TTL=864000

# Refresh token time-to-live, in seconds.
# Refresh tokens are used to obtain a new access token without re-entering credentials.
REFRESH_TOKEN_TTL=604800

# Browser authentication session limits.
AUTH_SESSION_TTL=300
AUTH_SESSION_MAX_ATTEMPTS=5
AUTH_SESSION_LOCK_SECONDS=60

# Password login throttling by username and address, by address, and by account. A value of 0
# disables that scope; see the README section "Login throttling" before changing these values.
LOGIN_MAX_FAILURES_PER_USER_IP=5
LOGIN_MAX_FAILURES_PER_IP=100
LOGIN_MAX_FAILING_IPS_PER_ACCOUNT=50
LOGIN_LOCK_BASE_SECONDS=60
LOGIN_LOCK_MAX_SECONDS=900
# Sources that logged in successfully as an account within this many seconds are not blocked by the
# account-wide lock. 0 turns this exemption off.
LOGIN_RECENT_SUCCESS_SECONDS=2592000

# Number of trusted reverse proxies in front of this service. Keep 0 when clients connect directly.
# A value above the real proxy count lets clients forge the address used for throttling. When it is
# above 0, the service must be reachable only through those proxies. If the logs show a [proxy]
# warning, a reverse proxy is probably in front of the service and this value must be set.
TRUSTED_PROXY_COUNT=0

# RSA key storage directory.
KEY_DIR=./keys

# Database path.
DB_PATH=./lore-auth.db

# Administrator account created on first startup. ADMIN_PASSWORD is required: the service refuses
# to start without a password of at least 8 characters that is not a publicly documented value.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Local development only: uncomment to accept the publicly documented values changeme and the
# placeholder above. If ADMIN_PASSWORD is unset, the administrator password is changeme.
# Never enable this on a reachable deployment.
# ALLOW_INSECURE_DEFAULT_ADMIN_PASSWORD=true

# Production Lore Client integration requires a publicly trusted certificate.
# The certificate must cover the host used in https://<host>:50051.
# TLS_CERT_FILE=./certs/fullchain.pem
# TLS_KEY_FILE=./certs/privkey.pem

# Docker only: override with the public HTTPS health URL when TLS is enabled.
# HEALTHCHECK_URL=https://auth.example.com:8080/health_check
