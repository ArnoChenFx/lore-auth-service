{
  "name": "lore-auth",
  "version": "0.1.12",
  "description": "Native browser authentication, JWT authorization, JWKS, and ReBAC service for Lore VCS",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "bootstrap": "bun run src/index.ts --bootstrap",
    "build:compile": "bun run scripts/compile.ts",
    "build:compile:all": "bun run scripts/compile.ts --all",
    "repository:id": "bun run scripts/repository-id.ts",
    "test:compiled": "bun run scripts/smoke-compiled.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.3"
  }
}
